{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH Persona Installer",
  "mainBinaryName": "dsh-persona-installer",
  "version": "0.1.0",
  "identifier": "com.lomehong.dsh-persona-installer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DSH 数字分身 - 安装向导",
        "url": "index.html",
        "width": 920,
        "height": 640,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}