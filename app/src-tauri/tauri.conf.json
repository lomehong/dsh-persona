{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dsh-persona",
  "mainBinaryName": "dsh-persona-app",
  "version": "1.0.0",
  "identifier": "com.lomehong.dsh-persona",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "数字分身",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.ico", "icons/icon.icns", "icons/icon.png"]
  }
}
